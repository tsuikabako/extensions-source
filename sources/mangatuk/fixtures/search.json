:{"locked":false,"kind":"free","changesAt":null}}]},{"id":"wpser_7b89691a67555f07f4d5d27f54","slug":"her-merry-obsession","title":"Merry Psycho","associatedNames":"هَوَس ميري القاتل\nميري… الهَوَس القاتل\nميري سايكو\nHer Merry Obsession\nSu obsesión letal\nЖениться на психопатке\nสภาวะคลั่งรัก\nメリーサイコ\n特務惹上瘋狗\n메리 사이코","description":"لمدة عامين سعيدين، كان عالم سوريونغ يدور حول زوجها وحده، إلى أن اختفى فجأةً دون أن يترك أثراً.\n\nوفي أثناء بحثها عن الحقيقة، تكتشف واقعاً مؤلماً: أنه لم يكن لها منذ البداية.\n\nلكنها لا تنوي أن تتركه يفلت من بين يديها، حتى لو كان عميلاً للعمليات السرية، يتخفّى بمئة وجه ووجه.","descriptionHtml":null,"author":"Dry Fish Girl","translator":"lavnakim","status":"ongoing","type":"manhwa","format":null,"coverImage":"https://content.mangatuk.com/axis/covers/aojjxtpj9inxdnned0uosrt4.webp","isTraining":false,"commentsEnabled":true,"commentsVisible":true,"createdBy":"wpusr_f2ab7acafab78bd88c4b9824b6","updatedBy":"Y78yvL2GAserdlV4khi0CfhPwBQTZrRT","viewCount":2096015,"coinValue":0,"bookmarkCount":8955,"ratingCount":62,"ratingAvg":"9.21","createdAt":"2025-05-06T11:53:39.000Z","deletedAt":null,"deletedBy":null,"updatedAt":"2026-10-24T17:26:26.094Z","chapterCount":79,"latestChapter":{"id":"ev2mjcwf0isweckutdtn39n6","seriesId":"wpser_7b89691a67555f07f4d5d27f54","number":76,"title":"","slug":"chapter-76","createdBy":"wpusr_f2ab7acafab78bd88c4b9824b6","uploadedByUserId":"wpusr_f2ab7acafab78bd88c4b9824b6","uploadedByTeamId":"wpteam_f2ab7acafab78bd88c4b9824b6","uploadedByTeamName":"lavnakim","updatedBy":"wpusr_f2ab7acafab78bd88c4b9824b6","viewCount":793,"isAdult":true,"coinValue":10,"coinLockStartsAt":null,"coinLockEndsAt":null,"createdAt":"2026-10-17T14:28:36.191Z","publishedAt":"2026-10-17 14:50:14.046","updatedAt":"2026-10-17T14:50:14.046Z","coinAccess":{"locked":true,"kind":"permanent","changesAt":null}},"hasAdultChapters":true,"recentChapters":[{"id":"ev2mjcwf0isweckutdtn39n6","seriesId":"wpser_7b89691a67555f07f4d5d27f54","number":76,"title":"","slug":